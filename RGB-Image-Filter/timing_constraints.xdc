create_clock -period 12.000 -name clk_125MHz -waveform {0.000 6.000} [get_ports clk_125MHz]
create_clock -period 6.000 -name VIRTUAL_DCM_TMDS_CLKFX -waveform {0.000 3.000}
create_clock -period 60.000 -name VIRTUAL_MMCM_pix_clock -waveform {0.000 30.000}
set_input_delay -clock [get_clocks VIRTUAL_DCM_TMDS_CLKFX] -min -add_delay 0.100 [get_ports reset]
set_input_delay -clock [get_clocks VIRTUAL_DCM_TMDS_CLKFX] -max -add_delay 0.100 [get_ports reset]
set_input_delay -clock [get_clocks VIRTUAL_MMCM_pix_clock] -min -add_delay 0.100 [get_ports reset]
set_input_delay -clock [get_clocks VIRTUAL_MMCM_pix_clock] -max -add_delay 0.100 [get_ports reset]
set_output_delay -clock [get_clocks VIRTUAL_DCM_TMDS_CLKFX] -min -add_delay 0.000 [get_ports {TMDSn[*]}]
set_output_delay -clock [get_clocks VIRTUAL_DCM_TMDS_CLKFX] -max -add_delay 0.100 [get_ports {TMDSn[*]}]
set_output_delay -clock [get_clocks VIRTUAL_DCM_TMDS_CLKFX] -min -add_delay 0.000 [get_ports {TMDSp[*]}]
set_output_delay -clock [get_clocks VIRTUAL_DCM_TMDS_CLKFX] -max -add_delay 0.100 [get_ports {TMDSp[*]}]

set_property PACKAGE_PIN L16 [get_ports TMDSp_clock]
set_property PACKAGE_PIN J18 [get_ports {TMDSp[2]}]
set_property PACKAGE_PIN K19 [get_ports {TMDSp[1]}]
set_property PACKAGE_PIN K17 [get_ports {TMDSp[0]}]
set_property PACKAGE_PIN M19 [get_ports {sel[1]}]
set_property PACKAGE_PIN M20 [get_ports {sel[0]}]
set_property PACKAGE_PIN H16 [get_ports clk_125MHz]
set_property PACKAGE_PIN D19 [get_ports reset]
set_property IOSTANDARD TMDS_33 [get_ports TMDSp_clock]
set_property IOSTANDARD LVCMOS33 [get_ports reset]
set_property IOSTANDARD LVCMOS33 [get_ports clk_125MHz]
set_property IOSTANDARD TMDS_33 [get_ports {TMDSp[2]}]
set_property IOSTANDARD TMDS_33 [get_ports {TMDSp[1]}]
set_property IOSTANDARD TMDS_33 [get_ports {TMDSp[0]}]
#set_property IOSTANDARD TMDS_33 [get_ports {TMDSn[0]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sel[1]}]
set_property IOSTANDARD LVCMOS33 [get_ports {sel[0]}]
