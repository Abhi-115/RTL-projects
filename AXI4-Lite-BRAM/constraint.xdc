create_clock -period 10.000 -name CLK -waveform {0.000 5.000} [get_ports CLK]
set_input_delay -clock [get_clocks CLK] -min -add_delay 0.10 [get_ports {CMD_IN[*]}]
set_input_delay -clock [get_clocks CLK] -max -add_delay 0.10 [get_ports {CMD_IN[*]}]
set_input_delay -clock [get_clocks CLK] -min -add_delay 0.10 [get_ports {DATA_IN[*]}]
set_input_delay -clock [get_clocks CLK] -max -add_delay 0.10 [get_ports {DATA_IN[*]}]
set_input_delay -clock [get_clocks CLK] -min -add_delay 0.10 [get_ports RESETN]
set_input_delay -clock [get_clocks CLK] -max -add_delay 0.10 [get_ports RESETN]
set_input_delay -clock [get_clocks CLK] -min -add_delay 0.10 [get_ports START]
set_input_delay -clock [get_clocks CLK] -max -add_delay 0.10 [get_ports START]
#set_output_delay -clock [get_clocks CLK] -min -add_delay 0.100 [get_ports {DATA_OUT[*]}]
#set_output_delay -clock [get_clocks CLK] -max -add_delay 0.100 [get_ports {DATA_OUT[*]}]
set_output_delay -clock [get_clocks CLK] -min -add_delay 0.100 [get_ports GET_CMD]
set_output_delay -clock [get_clocks CLK] -max -add_delay 0.100 [get_ports GET_CMD]
#set_output_delay -clock [get_clocks CLK] -min -add_delay 0.100 [get_ports GET_DATA]
#set_output_delay -clock [get_clocks CLK] -max -add_delay 0.100 [get_ports GET_DATA]
